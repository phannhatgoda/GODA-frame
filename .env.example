# Bắt buộc: chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự). Tạo bằng: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-please-32chars
# Email sẽ tự động là Super Admin khi đăng ký (nếu bỏ trống: tài khoản đầu tiên là Super Admin)
ADMIN_EMAIL=
# Postgres (Neon). Trên Vercel: tạo Neon trong tab Storage, biến DATABASE_URL được tự động thêm.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# URL công khai của ứng dụng (dùng tạo link chia sẻ & QR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tuỳ chọn: bật tính năng "AI viết caption" (Claude API)
ANTHROPIC_API_KEY=
