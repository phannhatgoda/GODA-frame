# Bắt buộc: chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự). Tạo bằng: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-please-32chars
# Email sẽ tự động là Super Admin khi đăng ký (nếu bỏ trống: tài khoản đầu tiên là Super Admin)
ADMIN_EMAIL=
# Database: mặc định SQLite file local. Có thể dùng Turso: libsql://xxx.turso.io
DATABASE_URL=file:./data/goda-frame.db
DATABASE_AUTH_TOKEN=
# Thư mục lưu file upload (frame, logo, ảnh bìa)
UPLOAD_DIR=./data/uploads
# URL công khai của ứng dụng (dùng tạo link chia sẻ)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tuỳ chọn: bật tính năng "AI viết caption" (Claude API)
ANTHROPIC_API_KEY=
